{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Database": {
    "ApplyMigrationsOnStartup": false
  },

  "Jwt": {
    "Issuer": "FutsalBooking.Api",
    "Audience": "FutsalBooking.Frontend",
    "Secret": "",
    "ExpiryMinutes": 480
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "App": {
    "FrontendBaseUrl": "http://localhost:5173",
    "PublicApiBaseUrl": "http://localhost:5183",
    "TimeZone": "Asia/Kathmandu"
  },

  "Booking": {
    "ReferencePrefix": "FB",
    "MaxAdvanceDays": 30,
    "PlayerCancelCutoffHours": 2,
    "OnlinePaymentHoldMinutes": 15
  },

  "Reviews": {
    "RequireVerifiedBooking": true
  },

  "Esewa": {
    "ProductCode": "",
    "SecretKey": "",
    "FormUrl": "https://epay.esewa.com.np/api/epay/main/v2/form",
    "StatusCheckUrl": "https://epay.esewa.com.np/api/epay/transaction/status/"
  },

  "SeedAdmin": {
    "FullName": "Platform Admin",
    "Username": "",
    "Email": "",
    "Password": ""
  },

  "Swagger": {
    "EnableInProduction": false
  }
}